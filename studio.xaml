<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA Pottery Studio" Width="1420" Height="800" MinWidth="1120" MinHeight="590"
        WindowStartupLocation="CenterScreen" Background="#F5F2EB" FontFamily="Segoe UI"
        Foreground="#24332B" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,9,0,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F5F3ED"/>
            <Setter Property="BorderBrush" Value="#D3D7CE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="#E7EEE5"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="#D8E5D8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabFace" CornerRadius="10,10,0,0" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderThickness="1,1,1,0" BorderBrush="Transparent" TextElement.Foreground="#F3F4F1" TextElement.FontWeight="SemiBold">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFace" Property="Background" Value="#454C47"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFace" Property="Background" Value="#FFFEFB"/>
                                <Setter TargetName="TabFace" Property="BorderBrush" Value="#141614"/>
                                <Setter TargetName="TabFace" Property="TextElement.Foreground" Value="#24332B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border CornerRadius="11,11,0,0" Background="#303632" BorderBrush="#141614" BorderThickness="1,1,1,0" Padding="7,6,7,0">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="BorderBrush" Value="#B8BFB8"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="N O V A   /   C E R A M I C S" Foreground="#546B5C" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="Pottery Studio" FontSize="32" FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="365"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Border Background="#FFFEFB" BorderBrush="#DDDCD4" BorderThickness="1,0,1,1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TabControl x:Name="OptionsTabs" SelectedIndex="0">
                        <TabItem Header="Studio">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,15,18,12">
                            <TextBlock Style="{StaticResource Section}" Text="Model"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="148"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="Model" AutomationProperties.Name="Built-in pottery model" SelectedIndex="0" VerticalAlignment="Top">
                                    <ComboBoxItem Tag="BOWL">Serving Bowl</ComboBoxItem>
                                    <ComboBoxItem Tag="VASE">Bud Vase</ComboBoxItem>
                                    <ComboBoxItem Tag="CUP">Tea Cup</ComboBoxItem>
                                </ComboBox>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Button x:Name="ImportModel" ToolTip="Import GLB or photo to generate GLB" AutomationProperties.Name="Import GLB or photo to generate GLB"
                                            HorizontalAlignment="Center">
                                        <Path Data="M8,1 L8,10 M4,6 L8,10 L12,6 M1,10 L1,15 L15,15 L15,10" Width="16" Height="16"
                                              Stroke="#324A3C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    </Button>
                                    <TextBlock Text="Import GLB or photo to generate GLB" FontSize="11" Foreground="#52625A" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ModelFile" Foreground="#4F6458" FontSize="12" Margin="0,5,0,0" Visibility="Collapsed"/>

                            <Separator Margin="0,12,0,11" Background="#DDDCD4"/>
                            <TextBlock Style="{StaticResource Section}" Text="Glaze composition"/>
                            <TextBlock Foreground="#52625A" FontSize="12" Text="Choose a preset or make a custom color."/>
                            <RadioButton x:Name="Celadon" GroupName="Glaze" Tag="CELADON" IsChecked="True" Margin="0,8,0,0" AutomationProperties.Name="Jade Celadon, glossy green">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="15" Height="15" Fill="#729882" Margin="4,0,8,0"/>
                                    <TextBlock Text="Jade Celadon" Width="123" FontWeight="SemiBold"/>
                                    <TextBlock Text="Glossy green" Foreground="#52625A"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Cobalt" GroupName="Glaze" Tag="COBALT" Margin="0,7,0,0" AutomationProperties.Name="Cobalt Blue, deep gloss">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="15" Height="15" Fill="#365A88" Margin="4,0,8,0"/>
                                    <TextBlock Text="Cobalt Blue" Width="123" FontWeight="SemiBold"/>
                                    <TextBlock Text="Deep gloss" Foreground="#52625A"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="Oatmeal" GroupName="Glaze" Tag="OATMEAL" Margin="0,7,0,0" AutomationProperties.Name="Speckled Oatmeal, warm satin">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="15" Height="15" Fill="#C6A67C" Margin="4,0,8,0"/>
                                    <TextBlock Text="Speckled Oatmeal" Width="123" FontWeight="SemiBold"/>
                                    <TextBlock Text="Warm satin" Foreground="#52625A"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CustomGlaze" GroupName="Glaze" Tag="CUSTOM" Margin="0,7,0,0" AutomationProperties.Name="Custom glaze color">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="CustomSwatch" Width="15" Height="15" Fill="#C84B32" Margin="4,0,8,0"/>
                                    <TextBlock Text="Custom color" Width="123" FontWeight="SemiBold"/>
                                    <TextBlock Text="Color wheel" Foreground="#52625A"/>
                                </StackPanel>
                            </RadioButton>
                            <Border x:Name="CustomColorPanel" Visibility="Collapsed" Background="#F5F2EB" CornerRadius="8" Padding="8" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Image x:Name="CustomColorWheel" Width="174" Height="174" Stretch="Fill" Cursor="Cross" AutomationProperties.Name="Custom glaze color wheel"/>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Glaze preview" FontWeight="SemiBold" FontSize="12"/>
                                            <Border Margin="0,5,0,4" Height="48" CornerRadius="6" BorderBrush="#C7B29F" BorderThickness="1" Background="#C6A58A">
                                                <Border x:Name="CustomColorPreview" CornerRadius="5" Background="#C84B32"/>
                                            </Border>
                                            <TextBlock x:Name="CustomColorHex" Text="#C84B32" FontSize="12"/>
                                            <TextBlock x:Name="CustomOpacityLabel" Text="100% opacity" FontSize="11" Foreground="#52625A"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Field}" Text="Glaze opacity"/>
                                    <Slider x:Name="CustomOpacity" Minimum="0" Maximum="1" Value="1" SmallChange="0.01" LargeChange="0.1" AutomationProperties.Name="Custom glaze opacity"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="Full opacity" FontSize="11"/>
                                        <TextBlock Text="Clear" FontSize="11"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,12,0,10" Background="#DDDCD4"/>
                            <TextBlock Style="{StaticResource Section}" Text="Application and firing"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Target="{Binding ElementName=Thickness}" Content="Glaze thickness (mm)" Padding="0" Margin="0,0,0,4" FontSize="12"/>
                                    <TextBox x:Name="Thickness" ToolTip="Nominal glaze thickness in millimeters. Leave blank if unknown."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Target="{Binding ElementName=Temperature}" Content="Peak temperature (°C)" Padding="0" Margin="0,0,0,4" FontSize="12"/>
                                    <TextBox x:Name="Temperature" ToolTip="Peak firing temperature in degrees Celsius. Leave blank if unknown."/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Leave unknown values blank. Thickness and firing inputs are saved in the setup." Foreground="#52625A" FontSize="12" Margin="0,7,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Additional Options">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="10,4,10,10" TextElement.FontWeight="Normal">
                                    <TextBlock Style="{StaticResource Field}" Text="Kiln atmosphere"/>
                                    <ComboBox x:Name="Atmosphere" SelectedIndex="0" AutomationProperties.Name="Kiln atmosphere">
                                        <ComboBoxItem>Unspecified</ComboBoxItem>
                                        <ComboBoxItem Tag="oxidation">Oxidation</ComboBoxItem>
                                        <ComboBoxItem Tag="neutral">Neutral</ComboBoxItem>
                                        <ComboBoxItem Tag="reduction">Reduction</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Field}" Text="Atmosphere timing and strength"/>
                                    <TextBox x:Name="AtmosphereNotes" AutomationProperties.Name="Atmosphere timing and strength"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Pyrometric cone"/>
                                    <TextBox x:Name="Cone" AutomationProperties.Name="Pyrometric cone" ToolTip="Text field preserves cone numbers such as 06."/>
                                    <TextBlock Style="{StaticResource Field}" Text="Heat-up rate (°C/hour)"/>
                                    <TextBox x:Name="Ramp" AutomationProperties.Name="Heat-up rate"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Peak hold (minutes)"/>
                                    <TextBox x:Name="Soak" AutomationProperties.Name="Peak hold in minutes"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Firing schedule or notes"/>
                                    <TextBox x:Name="Schedule" AutomationProperties.Name="Firing schedule or notes"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Cooling rate (°C/hour)"/>
                                    <TextBox x:Name="CoolingRate" AutomationProperties.Name="Cooling rate"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Cooling profile or holds"/>
                                    <TextBox x:Name="CoolingProfile" AutomationProperties.Name="Cooling profile or holds"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Clay body ID or type"/>
                                    <TextBox x:Name="Clay" AutomationProperties.Name="Clay body ID or type"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Fired clay color (sRGB hex)"/>
                                    <TextBox x:Name="ClayColor" AutomationProperties.Name="Fired clay color" ToolTip="Use #RRGGBB for a measured fired clay color."/>
                                    <TextBlock Style="{StaticResource Field}" Text="Thickness map path (optional)"/>
                                    <TextBox x:Name="ThicknessMap" AutomationProperties.Name="Thickness map path"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Firing orientation or geometry notes"/>
                                    <TextBox x:Name="Geometry" AutomationProperties.Name="Firing orientation or geometry notes"/>
                                    <TextBlock Style="{StaticResource Field}" Text="Glaze layers"/>
                                    <TextBlock Text="1 layer · fixed" Foreground="#52625A"/>
                                    <Button x:Name="LocateBlender" Content="Locate Blender…" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    <TextBlock x:Name="BlenderPath" Foreground="#52625A" FontSize="11" Margin="0,4,0,0"/>
                                    <Button x:Name="SetupPhotoGenerator" Content="Set Up Photo Generator" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                    <TextBlock Text="One-time dependency and model download for photo-to-GLB." Foreground="#52625A" FontSize="11" Margin="0,4,0,0"/>
                                    <CheckBox x:Name="BakePhotoTexture" Content="Bake photo texture into GLB (slower)" Margin="0,8,0,0"/>
                                    <CheckBox x:Name="DraftPhotoMesh" Content="Draft photo mesh (faster, less detail)" Margin="0,6,0,0"/>
                                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

                    <Border Grid.Row="1" BorderBrush="#DDDCD4" BorderThickness="0,1,0,0" Padding="18,11">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="Render" Content="Render Preview" FontWeight="SemiBold" IsDefault="True"/>
                            <Button x:Name="ExportSetup" Content="Export Setup…" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FFFEFB" BorderBrush="#DDDCD4" BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="Orient" DockPanel.Dock="Right" Content="Orient Model"/>
                        <TextBlock Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" Text="Studio preview"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#E9E5DC" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="Pottery render"/>
                            <TextBlock x:Name="EmptyPreview" Text="Your Blender render will appear here." HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="#52625A" Margin="14" TextAlignment="Center"/>
                            <Grid x:Name="OrientationEditor" Visibility="Collapsed" Background="#E9E5DC">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Viewport3D IsHitTestVisible="False">
                                    <Viewport3D.Camera>
                                        <OrthographicCamera Position="3.7,2.7,6.5" LookDirection="-3.7,-2.7,-6.5" UpDirection="0,1,0" Width="4"/>
                                    </Viewport3D.Camera>
                                    <ModelVisual3D>
                                        <ModelVisual3D.Content>
                                            <Model3DGroup>
                                                <AmbientLight Color="#727272"/>
                                                <DirectionalLight Color="#CBCBCB" Direction="1,-2,-3"/>
                                                <DirectionalLight Color="#6D6D6D" Direction="-2,0,1"/>
                                            </Model3DGroup>
                                        </ModelVisual3D.Content>
                                    </ModelVisual3D>
                                    <ModelVisual3D x:Name="OrientationModel"/>
                                </Viewport3D>
                                <Border x:Name="RotateSurface" Background="Transparent" Cursor="SizeAll"
                                        ToolTip="Drag to turn and tilt. Use the Roll slider to rotate sideways."/>
                                <Border Background="#F5F2EB" CornerRadius="6" Padding="8,5" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                                    <TextBlock Text="Live model preview" Foreground="#52625A" FontSize="11"/>
                                </Border>
                                <Grid Grid.Row="1" Background="#F5F2EB" Margin="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="8,4">
                                        <TextBlock Text="Turn"/>
                                        <Slider x:Name="Turn" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Turn in degrees"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,4">
                                        <TextBlock Text="Tilt"/>
                                        <Slider x:Name="Tilt" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Tilt in degrees"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,4">
                                        <TextBlock Text="Roll"/>
                                        <Slider x:Name="Roll" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True" AutomationProperties.Name="Roll in degrees"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" x:Name="ResetOrientation" Content="Reset" Margin="6"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PreviewLabel" FontWeight="SemiBold"/>
                            <TextBlock x:Name="Status" Text="Ready" Foreground="#52625A" FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="SavePreview" Content="Save PNG…" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="#FFFEFB" BorderBrush="#DDDCD4" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NOVA assistant" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Text="Ask for pottery settings or help." Foreground="#52625A" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="ChatKeyToggle" Content="API key…" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <Border x:Name="ChatKeyPanel" Grid.Row="1" Visibility="Collapsed" Background="#F5F2EB" CornerRadius="8" Padding="9" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="OpenRouter API key" FontSize="12" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="ChatApiKey" Margin="0,5,0,0" AutomationProperties.Name="OpenRouter API key"/>
                            <TextBlock Text="Chat text is sent to OpenRouter and its selected model." FontSize="10" Foreground="#52625A" Margin="0,5,0,0"/>
                            <DockPanel Margin="0,7,0,0">
                                <TextBlock Text="Encrypted for this Windows account." FontSize="10" Foreground="#52625A" VerticalAlignment="Center"/>
                                <Button x:Name="ChatSaveKey" Content="Save key" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#F5F2EB" CornerRadius="8" Padding="8">
                        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel x:Name="ChatMessages">
                                    <Border Background="#FFFEFB" CornerRadius="8" Padding="9" Margin="0,0,0,7" HorizontalAlignment="Left">
                                        <TextBlock Text="Hi, I’m NOVA. How can I help with your pottery today? Ask me about a glaze or tell me what you’d like to change." FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="ChatThinking" Text="Thinking…" Visibility="Collapsed" Foreground="#52625A" FontSize="12" Margin="8,2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="ChatInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Message NOVA assistant"/>
                        <DockPanel Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="Ctrl+Enter to send" Foreground="#52625A" FontSize="11" VerticalAlignment="Center"/>
                            <Button x:Name="ChatSend" Content="Send" HorizontalAlignment="Right" Margin="0,0,0,0" IsDefault="False" DockPanel.Dock="Right"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
